{
  "name": "repairvantage-server",
  "version": "1.0.0",
  "description": "Backend for RepairVantage project management application",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/start.js",
    "dev": "prisma generate && tsx watch src/start.ts",
    "build": "prisma generate && tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev && prisma generate",
    "prisma:studio": "prisma studio",
    "test": "node --test test/unit.test.cjs",
    "prisma:deploy": "prisma migrate deploy",
    "test:integration": "node --test test/integration.test.cjs test/project-archive.test.cjs test/tasks.test.cjs test/task-assignment.test.cjs test/inventory.test.cjs test/schedule.test.cjs test/reporting.test.cjs test/demo-seed.test.cjs test/project-dates.test.cjs",
    "test:auth": "node --test test/auth.test.cjs"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "@better-auth/prisma-adapter": "1.7.14",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "graphql": "^16.15.0",
    "resend": "6.28.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "@protobufjs/utf8": "1.1.2"
  }
}
